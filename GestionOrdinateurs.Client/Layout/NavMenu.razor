@inject ISessionStorageService SessionStorage
@inject NavigationManager Nav

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">GestionOrdinateurs</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="ordinateurs">
                <span class="bi bi-pc-display-nav-menu" aria-hidden="true"></span> Ordinateurs
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="reparations">
                <span class="bi bi-tools-nav-menu" aria-hidden="true"></span> Réparations
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="login">
                <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> Connexion
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <button class="nav-link btn btn-link text-light" @onclick="Deconnecter">
                Déconnexion
            </button>
        </div>
    </nav>
</div>

@code {
    bool collapseNavMenu = true;

    string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;

    async Task Deconnecter()
    {
        await SessionStorage.RemoveItemAsync("authToken");
        Nav.NavigateTo("/", forceLoad: true);
    }
}
